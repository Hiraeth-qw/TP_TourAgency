@model TourAgencyClient.DTOs.TourSearchQuery?

@{
    var currentQuery = Model ?? new TourAgencyClient.DTOs.TourSearchQuery();
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-10 col-md-12">
        <form asp-controller="Home" asp-action="Search" method="get" class="p-4 rounded shadow-lg" style="background-color: #DAAD86;">
            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="location" class="form-label text-white fw-bold">Место (необязательно)</label>
                    <input type="text"
                           id="location"
                           name="Location"
                           class="form-control form-control-lg"
                           placeholder="Например: Италия, Париж..."
                           value="@currentQuery.Location" />
                </div>

                <div class="col-md-5">
                    <label for="startDate" class="form-label text-white fw-bold">Дата начала (необязательно)</label>
                    <input type="date"
                           id="startDate"
                           name="StartDate"
                           class="form-control form-control-lg"
                           value="@(currentQuery.StartDate.HasValue? currentQuery.StartDate.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-lg fw-bold" style="background-color: #659DBD; color: white;">
                        <i class="bi bi-search"></i> Найти
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>