@model List<TourAgencyClient.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Моя корзина";
}

<div class="p-4 mb-4 rounded shadow-sm bg-main-accent"">
    <h2>Ваш план отдыха</h2>
    <p class="mb-0">Здесь находятся выбранные вами туры. Нажмите "Забронировать", чтобы закрепить за собой места. Оплата производится на следующем этапе.</p>
</div>

<div class="container">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center mt-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">Ваша корзина пуста</h3>
            <a asp-controller="Home" asp-action="Index" class="btn btn-custom mt-3">Перейти к выбору туров</a>
        </div>
    }
    else
    {
        <div class="row" id="cartItemsContainer">
            @foreach (var item in Model)
            {
                <div class="col-12 mb-3 cart-item-card" id="card-@item.CartItemId">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h4 class="card-title mb-1" style="color: #659DBD">@item.Title</h4>
                                    <p class="text-muted mb-2"><i class="bi bi-geo-alt-fill"></i> @item.Location</p>

                                    <div class="d-flex gap-4 text-secondary small">
                                        <span><i class="bi bi-calendar-event"></i> @item.StartDate</span>
                                        <span><i class="bi bi-people-fill"></i> Туристов: <strong>@item.TouristsNumber</strong></span>
                                    </div>
                                </div>

                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                    <div class="mb-3">
                                        <span class="d-block text-muted small">Итоговая стоимость:</span>
                                        <span class="h3 fw-bold" style="color: black;">@item.TotalPrice.ToString("C")</span>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2">

                                        <button class="btn btn-outline-danger btn-remove-item"
                                                data-cart-id="@item.CartItemId">
                                            <i class="bi bi-trash"></i> Удалить
                                        </button>

                                        <button class="btn btn-custom btn-book-item"
                                                data-tour-id="@item.TourId"
                                                data-cart-id="@item.CartItemId"
                                                data-seats="@item.TouristsNumber">
                                            <i class="bi bi-cart-check"></i> Забронировать
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-book-item').on('click', function(e) {
                e.preventDefault();

                var btn = $(this);
                var originalText = btn.text();

                var requestData = {
                    TourId: btn.data('tour-id'),
                    CartItemId: btn.data('cart-id'),
                    TouristsNumber: btn.data('seats')
                };

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Обработка...');

                $.ajax({
                    url: '/Booking/CreateBooking',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function(response) {
                        showToast(response.message, true);

                        var card = $('#card-' + requestData.CartItemId);
                        card.fadeOut(500, function() {
                            $(this).remove();

                            if ($('.cart-item-card').length === 0) {
                                location.reload();
                            }
                        });
                    },
                    error: function(xhr) {
                        var errorMsg = "Не удалось забронировать.";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }

                        showToast(errorMsg, false);

                        btn.prop('disabled', false).text(originalText);
                    }
                });
            });

            $('.btn-remove-item').on('click', function(e) {
                e.preventDefault();

                var btn = $(this);
                var originalText = btn.text();
                var cartItemId = btn.data('cart-id');

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

                $.ajax({
                    url: '/Booking/RemoveFromCart',
                    type: 'POST',
                    data: { id: cartItemId },
                    success: function(response) {
                        showToast(response.message, true);
                        var card = $('#card-' + cartItemId);

                        card.fadeOut(500, function() {
                            $(this).remove();
                            if ($('.cart-item-card').length === 0) {
                                location.reload();
                            }
                        });
                    },
                    error: function(xhr) {
                        var errorMsg = "Не удалось удалить из корзины.";
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }

                        showToast(errorMsg, false);
                        btn.prop('disabled', false).text(originalText);
                    }
                });
            });

        });
    </script>
}