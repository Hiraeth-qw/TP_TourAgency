@model List<TourAgencyClient.DTOs.TourRead>

@{
    ViewData["Title"] = "Каталог Туров";
    var currentQuery = ViewData["CurrentSearchQuery"] as TourAgencyClient.DTOs.TourSearchQuery;
    bool isContentManager = User.IsInRole("ContentManager");
}


<div class="text-center bg-main-accent p-4 mb-4 rounded">
    <h1 class="display-4">Каталог Туров</h1>
</div>

@if (isContentManager)
{
    <div class="position-absolute top-50 end-0 translate-middle-y me-4">
        <a asp-action="Create" class="btn btn-light text-primary fw-bold shadow">
            <i class="bi bi-plus-circle-fill"></i> Добавить тур
        </a>
    </div>
}
<partial name="_TourSearchForm" model="currentQuery" />

<div class="container">
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            К сожалению, на данный момент нет доступных туров.a
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var tour in Model)
            {
                <div class="col-md-4 mb-4" id="tour-card-@tour.Id">
                    <div class="card card-custom">
                        <div class="card-header bg-main-accent">
                            <h5 class="card-title mb-0" title="@tour.Title">@tour.Title</h5>

                            @if (isContentManager)
                            {
                                <div class="end">
                                    <a asp-action="Edit" asp-route-id="@tour.Id" class="text-white me-2" title="Редактировать">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="#" class="text-white delete-tour-btn" data-id="@tour.Id" title="Удалить">
                                        <i class="bi bi-x-lg"></i>
                                    </a>
                                </div>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="card-text flex-grow-1">
                                @(tour.Description.Length > 100 ? tour.Description.Substring(0, 100) + "..." : tour.Description)
                            </p>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-price">
                                    @tour.Price руб.
                                </span>
                                <span class="badge bg-secondary">
                                    Осталось мест: @tour.AvailableSeats
                                </span>
                            </div>

                            <div class="mt-auto">
                                <a href="#" data-bs-toggle="modal" data-bs-target="#tourDetailsModal"
                                   data-tour-id="@tour.Id" class="btn btn-custom w-100 tour-details-btn">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="tourDetailsModal" tabindex="-1" aria-labelledby="tourDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quantitySelectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-main-accent text-white">
                <h5 class="modal-title" id="quantityModalTitle">Выбор мест</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="addToCartForm" action="/Booking/AddToCart" method="post">
                    <input type="hidden" id="hiddenTourId" name="TourId" />

                    <div class="mb-3">
                        <label for="touristsNumber" class="form-label">Количество мест (макс. 10):</label>
                        <input type="number" id="touristsNumber" name="TouristsNumber" class="form-control form-control-lg text-center"
                               value="1" min="1" required />
                    </div>

                    <div class="d-grid">
                        <button type="submit" id="submitAddToCart" class="btn btn-custom">
                            Подтвердить
                        </button>
                    </div>

                    <div id="quantityError" class="text-danger mt-2 text-center small" style="display:none;"></div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bookingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-main-accent text-white">
                <h5 class="modal-title">Бронирование тура</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="createBookingForm">
                    <input type="hidden" id="bookingHiddenTourId" />

                    <p class="lead text-center" id="bookingTourTitle"></p>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Количество мест:</label>
                        <input type="number" id="bookingTouristsNumber" class="form-control" value="1" min="1" max="10">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Клиент:</label>
                        <select id="clientUserId" class="form-select">
                            <option value="" disabled selected>Выберите клиента...</option>

                            @if (ViewData["ClientsList"] is List<TourAgencyClient.Models.ClientUserViewModel> clients)
                            {
                                @foreach (var client in clients)
                                {
                                    <option value="@client.Id">@client.DisplayName</option>
                                }
                            }
                        </select>
                        <span class="text-danger small mt-1" id="clientError" style="display:none;">
                            Пожалуйста, выберите клиента для бронирования.
                        </span>
                    </div>

                    <button type="submit" id="bookingSubmitBtn" class="btn btn-custom w-100">
                        Подтвердить бронирование
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.delete-tour-btn').click(function(e) {
                e.preventDefault();
                var btn = $(this);
                var tourId = btn.data('id');

                if (confirm('Вы действительно хотите удалить этот тур? Это действие необратимо.')) {
                    $.ajax({
                        url: '/Tour/Delete/' + tourId,
                        type: 'POST',
                        success: function(response) {
                            showToast('Тур успешно удален.', true);
                            $('#tour-card-' + tourId).fadeOut(500, function() { $(this).remove(); });
                        },
                        error: function(xhr) {
                            var msg = xhr.responseJSON ? xhr.responseJSON.message : "Ошибка удаления.";
                            showToast(msg, false);
                        }
                    });
                }
            });

            $(document).on("click", ".open-booking-modal-btn", function () {
                var tourId = $(this).data("tour-id");
                var title = $(this).data("tour-title");

                $("#tourDetailsModal").modal("hide");

                $('#bookingHiddenTourId').val(tourId);
                $('#bookingTourTitle').text("Тур: " + title);

                setTimeout(() => {
                    $("#bookingModal").modal("show");
                }, 400);
            });

            $("#createBookingForm").submit(function (e) {
                e.preventDefault();
                var form = $(this);
                var clientSelect = $('#clientUserId');
                var clientError = $('#clientError');
                var btn = form.find('#bookingSubmitBtn')
                var originalText = btn.text();

                if (!clientSelect.val()) {
                    clientError.slideDown(200);
                    clientSelect.addClass('is-invalid');
                    return;
                } else {
                    clientError.slideUp(200); 
                    clientSelect.removeClass('is-invalid');
                }

                var data = {
                    TourId: $("#bookingHiddenTourId").val(),
                    TouristsNumber: $("#bookingTouristsNumber").val(),
                    ClientUserId: $("#clientUserId").val()
                };

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>');

                $.ajax({
                    url: "/Booking/CreateBooking",
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function (resp) {
                        showToast("Бронирование создано", true);
                        $("#bookingModal").modal("hide");
                        btn.prop('disabled', false).text(originalText);
                    },
                    error: function () {
                        showToast("Ошибка бронирования", false);
                        btn.prop('disabled', false).text(originalText);
                    }
                });
            });
            
        });
    </script>
}