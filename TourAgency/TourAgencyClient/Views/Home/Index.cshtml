@model TourAgencyClient.DTOs.TourSearchQuery;

@{
    ViewData["Title"] = "Главная страница";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-8 col-md-10">

        <div class="p-5 text-center shadow-lg rounded bg-main-accent" style="border: 2px solid #BC986A;">
            <h1 class="display-4">Туристическое агентство для вас</h1>
            <p>Найдите свой тур в поисках приключений</p>
        </div>

        <h3 class="text-center mt-5 mb-3" style="color: #BC986A;">Быстрый поиск тура</h3>

        <form asp-controller="Home" asp-action="Search" method="get" class="p-4 rounded shadow-sm" style="background-color: #DAAD86;">
            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="location" class="form-label text-white fw-bold">Место (необязательно)</label>
                    <input type="text"
                           id="location"
                           name="Location"
                           class="form-control form-control-lg"
                           placeholder="Например: Италия, Париж..." />
                </div>

                <div class="col-md-5">
                    <label for="startDate" class="form-label text-white fw-bold">Дата начала (необязательно)</label>
                    <input type="date"
                           id="startDate"
                           name="StartDate"
                           class="form-control form-control-lg" />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-lg fw-bold" style="background-color: #659DBD; color: white;">
                        <i class="bi bi-search"></i> Найти
                    </button>
                </div>
            </div>
        </form>

    </div>
</div>
