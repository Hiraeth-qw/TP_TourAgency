@model List<TourAgencyClient.DTOs.TourRead>

@{
    ViewData["Title"] = "Каталог Туров";
}


<div class="text-center bg-main-accent p-4 mb-4 rounded">
    <h1 class="display-4">Каталог Туров</h1>
    <p>Откройте для себя незабываемые приключения по всему миру.</p>
</div>

<div class="container">
    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            К сожалению, на данный момент нет доступных туров.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var tour in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card card-custom">
                        <div class="card-header bg-main-accent">
                            <h5 class="card-title mb-0">@tour.Title</h5>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="card-text flex-grow-1">
                                @(tour.Description.Length > 100 ? tour.Description.Substring(0, 100) + "..." : tour.Description)
                            </p>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-price">
                                    @tour.Price руб.
                                </span>
                                <span class="badge bg-secondary">
                                    Осталось мест: @tour.AvailableSeats
                                </span>
                            </div>

                            <div class="mt-auto">
                                <a href="#" data-bs-toggle="modal" data-bs-target="#tourDetailsModal"
                                   data-tour-id="@tour.Id" class="btn btn-custom w-100 tour-details-btn">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="tourDetailsModal" tabindex="-1" aria-labelledby="tourDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Загрузка...</span>
                </div>
            </div>
        </div>
    </div>
</div>