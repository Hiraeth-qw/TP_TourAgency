@model List<TourAgencyClient.DTOs.UserReadDto>

@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-4">
    <h2 class="mb-4 bg-main-accent rounded">Пользователи системы</h2>

    <form asp-action="Users" method="get" class="mb-4">
        <div class="input-group shadow-sm rounded">
            <input type="text" name="searchString" class="form-control"
                   placeholder="Поиск по имени, фамилии, роли, ID или Email..."
                   value="@ViewData["CurrentFilter"]">
            <button class="btn btn-custom" type="submit">
                <i class="bi bi-search"></i> Найти
            </button>
            @if (ViewData["CurrentFilter"] != null)
            {
                <a asp-action="Users" class="btn btn-secondary">Сбросить</a>
            }
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive rounded">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="text-white bg-secondary-accent">
                        <tr>
                            <th>Пользователь</th>
                            <th>Email / ID</th>
                            <th>Роли</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@user.FirstName @user.LastName</div>
                                        <small class="text-muted">@user.PhoneNumber</small>
                                    </td>
                                    <td>
                                        <div>@user.Email</div>
                                        <small class="text-muted" style="font-size: 0.75rem;">ID: @user.Id</small>
                                    </td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-secondary">
                                                @role
                                                <a href="#" class="text-white text-decoration-none remove-role-btn"
                                                   data-email="@user.Email"
                                                   data-role="@role"
                                                   title="Удалить роль">
                                                    <i class="bi bi-x"></i>
                                                </a>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="Профиль">
                                                <i class="bi bi-person-lines-fill"></i>
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-warning btn-change-role"
                                                    data-email="@user.Email"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#changeRoleModal"
                                                    title="Изменить роль">
                                                <i class="bi bi-shield-lock"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger btn-delete-user"
                                                    data-id="@user.Id"
                                                    data-name="@user.FirstName @user.LastName"
                                                    title="Удалить">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">Пользователи не найдены.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changeRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Изменение роли</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ChangeRole" method="post">
                <div class="modal-body">
                    <input type="hidden" name="Email" id="roleEmailInput" />
                    <p>Назначить новую роль для пользователя: <strong id="roleEmailDisplay"></strong></p>

                    <div class="mb-3">
                        <label for="RoleName" class="form-label">Выберите роль:</label>
                        <select name="RoleName" class="form-select" required>
                            <option value="Client">Client</option>
                            <option value="ContentManager">ContentManager</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-custom">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="deleteUserForm" asp-action="DeleteUser" method="post">
    <input type="hidden" name="id" id="deleteUserId" />
</form>
<form id="removeRoleForm" asp-action="RemoveRole" method="post">
    <input type="hidden" name="email" id="removeRoleEmail" />
    <input type="hidden" name="roleName" id="removeRoleName" />
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.btn-change-role').on('click', function() {
                var email = $(this).data('email');
                $('#roleEmailInput').val(email);
                $('#roleEmailDisplay').text(email);
            });

            $('.btn-delete-user').on('click', function() {
                var id = $(this).data('id');
                var name = $(this).data('name');

                if (confirm('Вы уверены, что хотите удалить пользователя "' + name + '"? Это действие необратимо.')) {
                    $('#deleteUserId').val(id);
                    $('#deleteUserForm').submit();
                }
            });
            $('.remove-role-btn').on('click', function(e) {
                e.preventDefault();
                var email = $(this).data('email');
                var role = $(this).data('role');

                if (confirm(`Вы уверены, что хотите забрать роль "${role}" у пользователя ${email}?`)) {
                    $('#removeRoleEmail').val(email);
                    $('#removeRoleName').val(role);
                    $('#removeRoleForm').submit();
                }
            });
        });
    </script>
}