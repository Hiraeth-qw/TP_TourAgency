@model TourAgencyClient.DTOs.UserReadDto
@{
    ViewData["Title"] = "Профиль пользователя";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header text-white text-center py-4 bg-main-accent">
            <i class="bi bi-person-badge display-1"></i>
            <h3 class="mt-2">@Model.FirstName @Model.LastName</h3>
            <span class="badge bg-warning text-dark">@Model.RoleString</span>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">ID:</dt>
                <dd class="col-sm-8 text-muted">@Model.Id</dd>

                <dt class="col-sm-4">Email:</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Телефон:</dt>
                <dd class="col-sm-8">@(Model.PhoneNumber ?? "Не указан")</dd>
            </dl>
            <hr>
            <div class="d-grid">
                <a asp-action="Users" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>